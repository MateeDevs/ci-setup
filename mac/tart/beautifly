#!/usr/bin/env python3
"""Build and publish Beautifly images."""

from __future__ import annotations

import argparse
from hashlib import sha256
import os
from pathlib import Path
import re
import subprocess
import sys

DIRECTORY = Path(__file__).resolve().parent
sys.path.insert(0, str(DIRECTORY.parents[1] / "scripts"))

from publishing import Image, Plan, entry_point, run, validate_namespace, validate_tag, workflow

REGISTRY = "registry-1.docker.io"
TEMPLATE = "matee.pkr.hcl"
PACKER_VARIABLES = {"xcode_version", "additional_xcode_versions", "java_version", "disk_size_gb"}


def recipe_tag(settings: str, xcode: str, java: str) -> str:
    digest = sha256(f"{settings}\n".encode())
    for path in [Path(TEMPLATE), *sorted(Path("scripts").glob("install-*.sh"))]:
        checksum = sha256(path.read_bytes()).hexdigest()
        digest.update(f"{checksum}  {path}\n".encode())
    return f"xcode{xcode}-jdk{java}-{digest.hexdigest()[:12]}"


def description(image: str, xcodes: list[str], java: str, disk: str) -> tuple[str, str]:
    return (
        "macOS Tart runner images for Apple silicon CI",
        f"""# Beautifly

macOS Tahoe Tart VM images for Apple silicon CI hosts.

| Tool | Configuration |
| --- | --- |
| Default Xcode | {xcodes[0]} |
| Installed Xcode versions | {" ".join(xcodes)} |
| Java | {java} |
| VM disk | {disk} GB |

Clone the VM with `tart clone {image} matee-swablu`.
Use `matee-altaria` if that is the runner name on the CI host.

[Setup instructions](https://github.com/MateeDevs/ci-setup/tree/master/mac/tart)""",
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("-y", "--yes", action="store_true", help="Approve all steps.")
    parser.add_argument("--namespace", default="mateedevs", help="Docker Hub namespace.")
    parser.add_argument("--set", action="append", default=[], metavar="NAME=VALUE",
                        help="Set a Packer variable. Use once for each variable.")
    parser.add_argument("--publish-only", action="store_true", help="Upload the local VM for TAG.")
    parser.add_argument("tag", nargs="?", metavar="TAG", help="Use this tag for the image.")
    args = parser.parse_args()
    if args.publish_only and (not args.tag or args.set):
        parser.error("--publish-only requires TAG. Omit build settings.")

    namespace = validate_namespace(args.namespace)
    tag = validate_tag(args.tag) if args.tag else None
    packer_args = []
    for setting in args.set:
        name, separator, _ = setting.partition("=")
        if not separator or name not in PACKER_VARIABLES:
            parser.error(f"Invalid Packer setting: {name}")
        packer_args.extend(["-var", setting])

    def resolve(account):
        settings_rows = []
        xcodes = []
        image_tag = tag
        if not args.publish_only:
            settings = subprocess.check_output(
                ["packer", "console", *packer_args, TEMPLATE],
                input='join(" ", concat([var.java_version, format("%v", var.disk_size_gb)], local.xcode_versions))\n',
                text=True,
            ).strip().removeprefix('"').removesuffix('"')
            values = settings.split()
            if len(values) < 3 or any(not re.fullmatch(r"[0-9]+(\.[0-9]+)*", value) for value in values):
                raise ValueError("Packer must return the Java version, disk size, and Xcode versions.")
            java, disk, *xcodes = values
            image_tag = tag or validate_tag(recipe_tag(settings, xcodes[0], java))

        tag_hash = sha256(f"{namespace}/{image_tag}\n".encode()).hexdigest()[:12]
        suffix = f"beautifly-{tag_hash}"
        vm = f"matee-{suffix}"
        image = Image(image_tag, f"{REGISTRY}/{namespace}/beautifly:{image_tag}", vm)
        details = None
        if xcodes:
            settings_rows = [
                ("Xcode", ", ".join([f"{xcodes[0]} (default)", *xcodes[1:]])),
                ("Java", java), ("Disk", f"{disk} GB"), ("Local VM", vm),
            ]
            details = description(image.ref, xcodes, java, disk)

        def build(_missing):
            run(["./scripts/download-xcode-archives.sh", *xcodes])
            run(["packer", "init", TEMPLATE])
            run(["packer", "build", *packer_args, "-var", f"name_suffix={suffix}", TEMPLATE])

        def upload(target):
            username, password = account
            run(
                ["tart", "push", target.local, target.ref],
                env={
                    **os.environ,
                    "TART_REGISTRY_HOSTNAME": REGISTRY,
                    "TART_REGISTRY_USERNAME": username,
                    "TART_REGISTRY_PASSWORD": password,
                },
            )

        return Plan(
            [image], settings_rows, details, build, upload,
            lambda target: run(["tart", "get", target.local], stdout=subprocess.DEVNULL),
            "Download missing Xcode archives and build the VM?",
        )

    os.chdir(DIRECTORY)
    return workflow("Beautifly", namespace, "beautifly", args.yes, args.publish_only, resolve)


if __name__ == "__main__":
    entry_point(main)
