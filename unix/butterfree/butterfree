#!/usr/bin/env python3
"""Build and publish Butterfree images."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

DIRECTORY = Path(__file__).resolve().parent
sys.path.insert(0, str(DIRECTORY.parents[1] / "scripts"))

from publishing import Image, Plan, entry_point, run, validate_namespace, validate_tag, workflow

SOURCE_URL = "https://github.com/MateeDevs/ci-setup/tree/master/unix/butterfree"


def markdown_table(rows):
    lines = ["| Component | Version |", "| --- | --- |"]
    for component, version in rows:
        version = version.replace("|", r"\|")
        lines.append(f"| {component} | `{version}` |")
    return "\n".join(lines)


def description(settings):
    common_rows = [
        ("Ubuntu", settings["UBUNTU_VERSION"]),
        ("Java", settings["JAVA_VERSION"]),
        ("Gradle", settings["GRADLE_VERSION"]),
        ("Kotlin/Native", settings["KOTLIN_VERSION"]),
        (
            "Android command-line tools",
            settings["ANDROID_CMDLINE_TOOLS_VERSION"],
        ),
        ("Android platform-tools", settings["ANDROID_PLATFORM_TOOLS_VERSION"]),
        ("Android build-tools", settings["ANDROID_BUILD_TOOLS_VERSIONS"]),
        ("Android platforms", settings["ANDROID_PLATFORM_VERSIONS"]),
    ]
    emulator_rows = common_rows + [
        ("Android emulator", settings["ANDROID_EMULATOR_VERSION"]),
        ("Emulator API", settings["EMULATOR_API_LEVEL"]),
        ("Emulator target", settings["EMULATOR_TARGET"]),
        ("Emulator architecture", settings["EMULATOR_ARCH"]),
        ("Emulator device", settings["EMULATOR_DEVICE"]),
        ("Maestro", settings["MAESTRO_VERSION"]),
    ]

    summary = "Versioned Android CI images for builds and Maestro emulator testing."
    variants = [
        ("Build", settings["BUTTERFREE_IMAGE_TAG"]),
        ("Emulator with Maestro", settings["EMULATOR_IMAGE_TAG"]),
    ]
    variant_lines = ["| Variant | Versioned tag |", "| --- | --- |"]
    variant_lines.extend(f"| {variant} | `{tag}` |" for variant, tag in variants)
    emulator_only_rows = emulator_rows[len(common_rows) :]

    full_description = (
        "# butterfree\n\n"
        + "Butterfree supplies Android CI images for builds and emulator tests "
        + "with Maestro. Select a variant by its versioned tag prefix.\n\n"
        + "## Current variants\n\n"
        + "\n".join(variant_lines)
        + "\n\n## Shared build toolchain\n\n"
        + markdown_table(common_rows)
        + "\n\n## Emulator additions\n\n"
        + markdown_table(emulator_only_rows)
        + f"\n\n## Source\n\n[Source files and instructions]({SOURCE_URL})\n\n"
        + "Butterfree generated this description from the effective build "
        + "configuration.\n"
    )
    return summary, full_description




def main():
    parser = argparse.ArgumentParser(
        description="Build and publish Butterfree images.",
        epilog="Build settings: --set NAME=VALUE, --ubuntu-version, --java-version, "
        "--emulator-api-level, --emulator-arch, --emulator-target, "
        "--emulator-name, and --emulator-device.",
        allow_abbrev=False,
    )
    parser.add_argument("-y", "--yes", action="store_true", help="Approve all steps.")
    parser.add_argument("--namespace", default=os.environ.get("DOCKERHUB_NAMESPACE", "mateedevs"))
    parser.add_argument(
        "--publish-only", action="append", metavar="TAG",
        help="Upload a local tag. Use once for each tag.",
    )
    args, resolver_args = parser.parse_known_args()
    options = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    for name in ("ubuntu-version", "java-version", "emulator-api-level", "emulator-arch",
                 "emulator-target", "emulator-name", "emulator-device"):
        options.add_argument(f"--{name}")
    options.add_argument("--set", action="append")
    options.parse_args(resolver_args)
    if args.publish_only and resolver_args:
        parser.error("--publish-only uses local tags. Omit build settings.")
    namespace = validate_namespace(args.namespace)
    tags = tuple(dict.fromkeys(validate_tag(tag) for tag in args.publish_only or ()))
    docker = os.environ.get("BUTTERFREE_DOCKER_COMMAND", "docker")

    def resolve(_account):
        if tags:
            images = [Image(tag, f"{namespace}/butterfree:{tag}") for tag in tags]
            rows = []
            details = None
            settings = {}
        else:
            resolver = os.environ.get("BUTTERFREE_VERSION_RESOLVER", str(DIRECTORY / "fetch-latest-versions.py"))
            output = subprocess.check_output(
                [resolver, "--format", "json", "--namespace", namespace, *resolver_args],
                text=True,
            )
            settings = json.loads(output)
            images = [
                Image(settings["BUTTERFREE_IMAGE_TAG"], settings["BUTTERFREE_IMAGE"], "butterfree"),
                Image(settings["EMULATOR_IMAGE_TAG"], settings["EMULATOR_IMAGE"], "emulator"),
            ]
            rows = [
                (label, settings[key])
                for label, key in (
                    ("Java", "JAVA_VERSION"),
                    ("Gradle", "GRADLE_VERSION"),
                    ("Kotlin/Native", "KOTLIN_VERSION"),
                    ("Android build tools", "ANDROID_BUILD_TOOLS_VERSIONS"),
                    ("Android platforms", "ANDROID_PLATFORM_VERSIONS"),
                    ("Emulator API", "EMULATOR_API_LEVEL"),
                    ("Maestro", "MAESTRO_VERSION"),
                )
            ]
            details = description(settings)

        def build(missing):
            run(
                [docker, "buildx", "bake", "--file", "docker-bake.hcl", "--load",
                 "--progress=plain", *(image.local for image in missing)],
                env={**os.environ, **settings},
            )

        return Plan(
            images, rows, details, build,
            lambda image: run([docker, "push", image.ref]),
            lambda image: run([docker, "image", "inspect", "--format", "{{.Id}}", image.ref],
                              stdout=subprocess.DEVNULL),
            "Build the missing images?",
        )

    os.chdir(DIRECTORY)
    return workflow("Butterfree", namespace, "butterfree", args.yes, bool(tags), resolve)


if __name__ == "__main__":
    entry_point(main)
